# Copie este arquivo para backend/.env e preencha os valores antes de rodar
# `uvicorn main:app --reload`. Nunca coloque a chave direto no código.

# Chave da API Groq (gere em https://console.groq.com/keys).
# Obrigatória para /api/analyze e /api/datasets/{id}/questions.
# Atenção: uma vez configurada, apenas as amostras compactadas necessárias são enviadas à API da Groq.
GROQ_API_KEY=

# Modelo Groq usado pelo agente. Opcional — padrão compatível com GPT-OSS.
GROQ_MODEL=openai/gpt-oss-20b

# Origens permitidas por CORS, separadas por vírgula. Opcional — já existia
# antes deste agente.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Em desenvolvimento, permite também portas alternativas escolhidas pelo Vite.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
